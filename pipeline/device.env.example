# Device configuration. Copy to device.env next to this file and fill it in:
#
#     cp device.env.example device.env && nano device.env
#
# Then check it with:  .venv/bin/python config.py
#
# One Jetson runs one camera. device.env holds the device key, so it stays out
# of git. Relative paths are relative to this folder.

# ── Server ────────────────────────────────────────────────────────────────────
# Supabase project → Edge Functions → ingest.
INGEST_URL=https://<project-ref>.supabase.co/functions/v1/ingest

# The camera's serial as entered on the dashboard's Configuration page.
DEVICE_SERIAL=<serial>

# Paste the line the dashboard shows once when the camera is added or its key is
# replaced. It looks like DEVICE_KEY_<serial>=<key>.
DEVICE_KEY_<serial>=<key>

# ── Camera ────────────────────────────────────────────────────────────────────
# An RTSP stream (rtsp://user:password@192.168.1.20:554/stream1) or a USB
# camera (/dev/video0).
CAMERA_SOURCE=<rtsp://... or /dev/video0>

# ── Model and calibration ─────────────────────────────────────────────────────
MODEL=models/best.pt
# Height calibration for this camera (y_pixel_to_height_scale_lookup.json).
CALIBRATION=config/y_pixel_to_height_scale_lookup.json
# Optional pathway annotation (LabelMe JSON). Leave empty to skip.
PATHWAY_ANNOTATION=

# ── Behaviour (the defaults are fine) ─────────────────────────────────────────
# Length of each recorded chunk. Incidents reach the dashboard about this late.
SEGMENT_MINUTES=5
# Clips cut from the annotated video (boxes and distances drawn on) or the raw footage.
CLIP_SOURCE=annotated
# How long processed footage stays on disk before it is deleted.
KEEP_HOURS=24
# GPU index, or cpu.
GPU=0
